  [31m✖[39m lazy=FALSE, globals=TRUE, stdout=TRUE
    Error of class ‘FutureLaunchError’ with message:
    Caught an unexpected error of class FutureError when trying to launch future (<unnamed-131>) on backend of class BatchtoolsBashFutureBackend. The reason was: Cannot reset a running future [future <unnamed-103> (1317daaf22e7bff67adbb75ebc34bd34-103); on 1317daaf22e7bff67adbb75ebc34bd34@hb-x1-2023<3531893>] [future <unnamed-131> (1317daaf22e7bff67adbb75ebc34bd34-131); on 1317daaf22e7bff67adbb75ebc34bd34@hb-x1-2023<3531893>]
    Test code:
    {
        message("Creating lazy futures:")
        if (!is.finite(nbrOfWorkers())) {
            future.tests::skip_test("Test requires a finite number of workers")
        }
        n <- min(3L, nbrOfWorkers() + 1L)
        xs <- as.list(1:n)
        fs <- lapply(xs, FUN = function(kk) {
            future({
                Sys.sleep(kk)
                kk
            }, lazy = TRUE)
        })
        vs <- vector("list", length = length(fs))
        ss <- vapply(fs, FUN = function(f) f$state, NA_character_)
        print(ss)
        stopifnot(all(ss == "created"))
        rs <- rep(NA, times = length(fs))
        for (ff in seq_along(fs)) {
            for (kk in ff:length(fs)) {
                message(sprintf("Checking if future #%d is resolved:", 
                    kk))
                rs[[kk]] <- resolved(fs[[kk]])
                ss <- vapply(fs, FUN = function(f) f$state, NA_character_)
                utils::str(list(ff = ff, kk = kk, ss = ss, rs = rs))
                nbrOfFinished <- sum(ss == "finished")
                if (inherits(fs[[kk]], "UniprocessFuture")) {
                    stopifnot(rs[[kk]], ss[[kk]] == "finished")
                }
                else if (inherits(fs[[kk]], "MultiprocessFuture")) {
                    stopifnot((!rs[[kk]] && ss[[kk]] == "running") || 
                      (rs[[kk]] && ss[[kk]] %in% c("running", "finished")))
                }
            }
            message(sprintf("Waiting for future #%d to finish ... ", 
                ff), appendLF = FALSE)
            vs[[ff]] <- value(fs[[ff]])
            message("done")
            rs[[ff]] <- resolved(fs[[ff]])
            stopifnot(rs[ff])
            ss <- vapply(fs, FUN = function(f) f$state, NA_character_)
            stopifnot(ss[ff] == "finished")
            nbrOfFinished <- sum(ss == "finished")
            if (inherits(fs[[kk]], "UniprocessFuture")) {
                stopifnot(nbrOfFinished == length(fs))
            }
            else {
                stopifnot(nbrOfFinished >= ff)
            }
        }
        ss <- vapply(fs, FUN = function(f) f$state, NA_character_)
        print(ss)
        stopifnot(all(ss == "finished"))
        message("Collecting values:")
        vs <- value(fs)
        str(vs)
        stopifnot(identical(vs, xs))
    }
